<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 page tabs, natural width: each pill hugs its label and the row is
     centered, so a short list does not turn into stretched bars. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical|center_horizontal"
    android:orientation="horizontal"
    android:paddingLeft="4dp"
    android:paddingTop="4dp"
    android:paddingRight="4dp"
    android:paddingBottom="4dp">

        <TextView
            android:id="@+id/pagebar_0"
            android:layout_width="wrap_content"
            android:minWidth="44dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/page_chip_empty"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/pagebar_1"
            android:layout_width="wrap_content"
            android:minWidth="44dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/page_chip_empty"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/pagebar_2"
            android:layout_width="wrap_content"
            android:minWidth="44dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/page_chip_empty"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/pagebar_3"
            android:layout_width="wrap_content"
            android:minWidth="44dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/page_chip_empty"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/pagebar_4"
            android:layout_width="wrap_content"
            android:minWidth="44dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/page_chip_empty"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/pagebar_5"
            android:layout_width="wrap_content"
            android:minWidth="44dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/page_chip_empty"
            android:ellipsize="end"
