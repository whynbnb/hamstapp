<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Re-arms the widget's half-hour refresh after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Per-app data/cache sizes (the storage screen and the app detail page).
         Granted by the user in "Usage access"; the app works without it. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <application
        android:label="囤囤"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Long-press shortcuts on 囤囤's own launcher icon. Each one
                 opens the app on the matching screen (handled in MainActivity,
                 which forwards the id to Dart). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The home-screen widget: recommended apps for the current hour,
             drawn with RemoteViews and refreshed by the system every half
             hour. Tapping a cell goes through WidgetTapActivity, which
             records the launch for 囤囤's statistics and starts the app. -->
        <receiver
            android:name=".HamstappWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Repaint immediately after installing a new build instead of
                     waiting for the launcher to ask again. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Alarms do not survive a reboot, and a clock/timezone change
                     changes which hourly slot is current. -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hamstapp_widget_info" />
        </receiver>
        <!-- 4x1 strip with the tile board's page tabs. No periodic updates:
             Dart pushes the page list whenever it changes. -->
        <receiver
            android:name=".PageBarWidgetProvider"
            android:exported="true"
            android:label="@string/pagebar_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pagebar_widget_info" />
        </receiver>
        <!-- Alarm target: repaints the widget every half hour even when 囤囤
             has not run since. -->
        <receiver
            android:name=".WidgetRefreshReceiver"
            android:exported="false" />
        <!-- Invisible trampoline behind a widget tap. Its own (empty) task and
             no history, so it cannot drag 囤囤's UI to the front or show up in
             Recents; it finishes before drawing anything. -->
        <activity
            android:name=".WidgetTapActivity"
            android:exported="false"
            android:theme="@style/WidgetTapTheme"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Shares downloaded APKs with the system package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Reads other apps' notifications to draw unread bubbles on their
             icons. Bound by the system; guarded by a signature permission and
             only active once the user grants notification access. -->
        <service
            android:name=".NotifListenerService"
            android:label="囤囤"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Hosts one installed web app (PWA) in its own window, driven by the
             site's manifest display mode. Started from the app only.

             Its own task (empty affinity + document launch) so a web app is a
             window of its own: it shows up separately in Recents and can be used
             beside the app instead of covering it. `intoExisting` makes
             re-opening the same site bring that window forward, the way an
             installed web app behaves, while each site gets its own. -->
        <activity
            android:name=".WebAppActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:documentLaunchMode="intoExisting"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
